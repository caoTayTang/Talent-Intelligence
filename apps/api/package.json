{
  "name": "@talent-intelligence/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "python -m uvicorn app.main:app --host 0.0.0.0 --port 4000 --reload",
    "build": "python -m compileall app",
    "start": "python -m uvicorn app.main:app --host 0.0.0.0 --port 4000",
    "typecheck": "python -m compileall app",
    "db:generate": "python -c \"print('FastAPI uses SQLAlchemy models; no generated DB client is required.')\"",
    "db:migrate": "python -m app.db_migrate"
  }
}
